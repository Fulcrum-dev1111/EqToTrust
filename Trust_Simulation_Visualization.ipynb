   "source": [
    "# Trust Simulation Visualization Notebook\n\n",
    "Use this notebook to visualize results from the Kuramoto-based trust scalar hypothesis simulations.\n\n",
    "## How to Use\n\n",
    "1. Run the provided code to simulate trust coherence dynamics.\n",
    "2. Use the plotting cells to explore the emergent behavior of `R(t)` (coherence) and `t(t)` (trust scalar).\n",
    "3. Modify parameters such as `K` (coupling strength) and analyze the outputs."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "collapsible": True
   },
   "outputs": [],
   "source": [
    "# Import dependencies\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n\n",
    "# Define your simulation and plotting functions here, or load them as a module.\n",
    "from sim.trust_pulse_sim import simulate, map_t\n\n",
    "# Example single simulation run\n",
    "R_series = simulate()\n",
    "t_series = map_t(R_series)\n\n",
    "# Quick check: R mean and t mean over time series\n",
    "R_mean = np.mean(R_series)\n",
    "t_mean = np.mean(t_series)\n\n",
    "print(f\"R_mean: {R_mean:.4f} | t_mean: {t_mean:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "collapsible": True
   },
   "outputs": [],
   "source": [
    "# Visualize simulation results across time (R(t) and t(t))\n",
    "def plot_time_series(R_series, t_series):\n",
    "    timesteps = np.arange(len(R_series))\n",
    "    fig, ax1 = plt.subplots(figsize=(10, 6))\n\n",
    "    color = 'tab:blue'\n",
    "    ax1.set_xlabel('Time Steps')\n",
    "    ax1.set_ylabel('R (Coherence)', color=color)\n",
    "    ax1.plot(timesteps, R_series, color=color, label=\"R (Coherence)\")\n",
    "    ax1.tick_params(axis='y', labelcolor=color)\n",
    "    ax1.legend(loc='upper left')\n\n",
    "    ax2 = ax1.twinx()  # instantiate a second y-axis\n",
    "    color = 'tab:orange'\n",
    "    ax2.set_ylabel('t (Trust Scalar)', color=color)\n",
    "    ax2.plot(timesteps, t_series, color=color, linestyle='--', label=\"t (Trust Scalar)\")\n",
    "    ax2.tick_params(axis='y', labelcolor=color)\n",
    "    ax2.legend(loc='upper right')\n\n",
    "    plt.title('R (Coherence) and t (Trust Scalar) over Time')\n",
    "    plt.grid()\n",
    "    plt.show()\n\n",
    "# Call the visualization function\n",
    "plot_time_series(R_series, t_series)"
   ]
  },
